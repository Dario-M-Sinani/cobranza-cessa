# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Solo aplican con DJANGO_SETTINGS_MODULE=config.settings.production (ver
# config/settings/production.py). Por defecto asumen que hay TLS terminado
# delante de gunicorn (nginx o un reverse-proxy externo) y fuerzan https +
# cookies seguras -- en un despliegue interno sin TLS (como 10.1.1.88, nginx
# sirve HTTP plano dentro de la red de CESSA) hay que poner los 3 en False,
# si no Django redirige todo a https y ahí no hay nada escuchando.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Base de datos (django-environ DATABASE_URL)
DATABASE_URL=postgres://cobranza:cobranza@localhost:5432/cobranza_cessa

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MC4/SIP (ver services/mc4_client.py) -- misma pasarela que usa cessa-laravel
# en producción (SipQrProvider.php) contra Banco BISA. Sin credenciales
# reales todavía.
MC4_CLIENT_CLASS=services.mc4_client.SipMC4Client
MC4_BASE_URL=
MC4_APIKEY=
MC4_USERNAME=
MC4_PASSWORD=
MC4_APIKEY_SERVICIO=

# Consulta de deuda -- GET {SIIC_DEUDA_BASE_URL}/v1/consulta/cliente, mismo
# endpoint y credenciales que CESSA_API_URL/CESSA_API_TOKEN en
# cessa-laravel/.env (CessaApiService). Pedir esas credenciales para
# completar esto localmente -- nunca commitear los valores reales acá.
DEUDA_CLIENT_CLASS=services.deuda_client.SiicDeudaClient
SIIC_DEUDA_BASE_URL=
SIIC_DEUDA_TOKEN=

# api-cobranzas-bancos (ver services/cobranzas_banco_client.py) -- registra
# cobros como factura real en el SIIC, para DOS orígenes distintos: (1) los
# pagos QR web de cessa-laravel, que le delegan la liquidación a este backend
# porque no tienen red hacia esta API (apps/facturacion_externa, usa
# pagar-otro-documento); y (2) los cobros propios de este panel -- efectivo o
# QR generado por un cajero de mostrador (apps/cobranza::enviar_factura_a_siic,
# usa /pagar a secas, misma Caja/Cajero para ambos). Un solo usuario/Caja
# compartido para todo el panel, no uno por cajero humano.
# Sin credenciales reales todavía -- queda con FakeCobranzasBancoClient.
COBRANZAS_BANCO_CLIENT_CLASS=services.fakes.FakeCobranzasBancoClient
COBRANZAS_BANCO_BASE_URL=
COBRANZAS_BANCO_CLIENT_ID=
COBRANZAS_BANCO_CLIENT_SECRET=
COBRANZAS_BANCO_USERNAME=
COBRANZAS_BANCO_PASSWORD=
COBRANZAS_BANCO_AGENCIA_SIGLA=
# Número de caja fijo para la apertura diaria (ej. 8199); vacío = lo asigna el SIIC
COBRANZAS_BANCO_CAJA_CODIGO=
# IDs de los catálogos GET /v1/entes y GET /v1/bancos -- pedir/consultar una
# vez que haya red hacia api-cobranzas-bancos (ver FacturacionRecibo.php de
# cessa-laravel para el porqué de estos dos campos).
COBRANZAS_BANCO_DOCUMENTO_ENTE_ID=
COBRANZAS_BANCO_DOCUMENTO_BANCO_ID=
# Opcionales: banco_id por banco del QR web (si faltan, se usa el de arriba).
COBRANZAS_BANCO_DOCUMENTO_BANCO_ID_BISA=
COBRANZAS_BANCO_DOCUMENTO_BANCO_ID_BNB=

# API key que usa cessa-laravel (Hostinger) para llamar a
# apps.facturacion_externa y pedir que se liquide un Recibo de su propio
# cobro QR web -- server-a-servidor, nunca el JWT de cajera/supervisor.
API_KEY_CESSA_LARAVEL=

# Callback único de SIP/BISA (ver config/settings/base.py). Usuario/clave = los registrados en
# el portal SIP. SIP_CALLBACK_URL es la URL pública de este endpoint, la que va en cada generaQr.
SIP_CALLBACK_USERNAME=
SIP_CALLBACK_PASSWORD=
SIP_CALLBACK_URL=https://test01.cessa.com.bo/api/externo/sip/confirmar-pago
SIP_CALLBACK_REENVIOS=CESSA-=https://test.cessa.com.bo/api/pagos/sip/confirmar-pago

# Pantallas táctiles de autoservicio (apps/kiosco). Un token por pantalla ("nombre=token,...");
# generar con: python -c "import secrets; print(secrets.token_urlsafe(32))". Necesita MC4_*.
KIOSCO_TOKENS=
KIOSCO_REDES=10.0.0.0/8,127.0.0.1/32
KIOSCO_MINUTOS_QR=5
KIOSCO_CONSULTAS_POR_MINUTO=30/min
# Barra de cortes. Programados: API interna (token en el header Authorization, sin "Bearer";
# VERIFY = ruta al .pem de Cloudflare Origin CA). Emergencias y respaldo: página de inicio de la web.
KIOSCO_CORTES_API_URL=https://10.1.1.106:8080/v1/scheduled-outages
KIOSCO_CORTES_API_TOKEN=
KIOSCO_CORTES_API_VERIFY=/opt/cobranza-cessa-prod/certs/cloudflare-origin-ca.pem
KIOSCO_AVISOS_URL=https://cessa.com.bo/
KIOSCO_AVISOS_MINUTOS=10
KIOSCO_GALERIA_MINUTOS=60

# Alertas de pagos web sin factura (services/alertas.py). Todo opcional.
ALERTAS_TELEGRAM_BOT_TOKEN=
ALERTAS_TELEGRAM_CHAT_IDS=
ALERTAS_EMAIL_DESTINOS=
PANEL_URL=
# Correo saliente para ALERTAS_EMAIL_DESTINOS (Gmail: smtp.gmail.com, 587, TLS y una
# contraseña de aplicación). Se cargan con deploy/configurar_correo_prod.sh.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
